# Copia questo file in .env solo se vuoi personalizzare i valori locali.
# I default di docker-compose.yml funzionano già senza .env.

POSTGRES_USER=accordo
POSTGRES_PASSWORD=accordo
POSTGRES_DB=accordo

# Segreto JWT: in locale va bene, in produzione usare una stringa lunga e casuale.
JWT_SECRET=dev-only-super-secret-change-me
JWT_EXPIRES_IN=7d

# Codice necessario in fase di registrazione per creare un account organizzatore.
ORGANIZER_INVITE_CODE=ORGANIZZA2026

# Porte esposte sull'host
API_PORT=4000
WEB_PORT=5173
DB_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
